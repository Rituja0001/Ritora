# Ritora Backend Environment Configuration Template
PROJECT_NAME="Ritora Real Estate API"
ENVIRONMENT="development"
API_PREFIX="/api"

# Database Connection
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="ritora_db"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/ritora_db"

# JWT Security
JWT_SECRET="replace_with_a_secure_random_secret_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# File Storage
UPLOAD_DIR="uploads"

# SMTP Settings (Optional)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="info@ritoraluxerealestate.ae"
NOTIFICATION_EMAIL="info@ritoraluxerealestate.ae"
